# ---------------------------------------------------------------------------
# Copy to `.env` and fill in real values. `.env` is gitignored.
# ---------------------------------------------------------------------------

# PostgreSQL connection string.
#
# Local development: run `npm run db:serve` (PGlite, PostgreSQL compiled to
# WASM) and use the URL below. Production: any hosted PostgreSQL
# (Neon, Supabase, RDS…) — nothing else in the app has to change.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/postgres"

# Signs the auth session JWT (HS256 via `jose`). REQUIRED in production:
# the app refuses to issue sessions with the placeholder value.
# Generate one with: openssl rand -base64 32
AUTH_SECRET="dev-only-change-me-please-32-chars-min"

# Public origin, used for metadataBase (Open Graph URLs) and sitemap.xml.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Set to "1" ONLY if the app must be embeddable in an iframe on another domain.
# It removes `frame-ancestors 'none'` / X-Frame-Options. Evaluated at BUILD time.
# COOKIE_SAMESITE_NONE is the runtime equivalent for the session cookie.
# ALLOW_IFRAME_EMBED="1"

# Set to "live" only after wiring a real provider in src/lib/payments.ts.
# Until then the checkout is a simulation and no money moves.
PAYMENTS_MODE="simulated"

# --- Stripe (optional but required to take real payments) -------------------
# Leave STRIPE_SECRET_KEY unset and the checkout runs in simulation mode.
# As soon as it is set, /checkout redirects to Stripe Checkout and orders are
# confirmed by webhook. Use sk_test_… first, then sk_live_…
# STRIPE_SECRET_KEY=""

# Signing secret of the webhook endpoint (whsec_…). Create an endpoint in the
# Stripe dashboard pointing at https://YOUR-DOMAIN/api/webhooks/stripe with the
# events: checkout.session.completed, checkout.session.expired,
# checkout.session.async_payment_failed
# STRIPE_WEBHOOK_SECRET=""

# Force the simulation even when a key is present (useful for demos).
# PAYMENTS_MODE="simulated"
