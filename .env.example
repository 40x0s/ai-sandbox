# ---------------------------------------------------------------------------
# Copy to `.env` and fill in real values. `.env` is gitignored.
# ---------------------------------------------------------------------------

# SQLite file used by Prisma + the libsql driver adapter (local dev only).
# For a real deployment point this at a durable database — a SQLite file does
# not survive serverless/ephemeral filesystems. See README "Production checklist".
DATABASE_URL="file:./prisma/dev.db"

# Signs the auth session JWT (HS256 via `jose`). REQUIRED in production:
# the app refuses to issue sessions with the placeholder value.
# Generate one with: openssl rand -base64 32
AUTH_SECRET="dev-only-change-me-please-32-chars-min"

# Public origin, used for metadataBase (Open Graph image URLs).
# e.g. https://atelier.example.com
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Set to "1" ONLY if the app must be embeddable in an iframe on another domain.
# It switches the session cookie to SameSite=None, which removes the browser's
# SameSite CSRF defence — leave unset for a normal standalone deployment.
# COOKIE_SAMESITE_NONE="1"
