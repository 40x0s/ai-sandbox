# Production environment template.
# Copy the values into your host's environment (do not commit a real .env).

# REQUIRED. Generate with: openssl rand -base64 32
# The app refuses to sign sessions in production with the placeholder value.
AUTH_SECRET=""

# REQUIRED for a real deployment. SQLite on a persistent volume works on a
# container host; serverless platforms need Postgres instead.
DATABASE_URL="file:/app/data/atelier.db"

# Public origin — used for metadataBase, Open Graph URLs and sitemap.xml.
NEXT_PUBLIC_SITE_URL="https://your-domain.com"

# Leave unset in production. Setting it to "1" removes frame-ancestors 'none'
# and X-Frame-Options so the app can be embedded in an iframe.
# ALLOW_IFRAME_EMBED=""

# Set to "live" only after wiring a real provider in src/lib/payments.ts.
# Until then the checkout is a simulation and no money moves.
PAYMENTS_MODE="simulated"
