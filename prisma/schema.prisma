// Prisma schema — SQLite (dev) via the libsql driver adapter.
// NOTE: SQLite supports neither enums nor scalar lists in Prisma, so `role`,
// `status`, sizes and colours are modelled as strings / relation tables.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Prisma 7: connection URLs live in prisma.config.ts (CLI) and in the driver
// adapter passed to PrismaClient (runtime) — not in the schema file.
datasource db {
  provider = "sqlite"
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  /// "CUSTOMER" | "ADMIN"
  role         String   @default("CUSTOMER")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  orders       Order[]
}

model Category {
  id       String    @id @default(cuid())
  name     String
  slug     String    @unique
  products Product[]
}

model Color {
  id       String    @id @default(cuid())
  name     String
  slug     String    @unique
  hex      String
  products Product[]
}

model Size {
  id       String    @id @default(cuid())
  label    String    @unique
  sort     Int       @default(0)
  products Product[]
}

model Product {
  id             String      @id @default(cuid())
  slug           String      @unique
  name           String
  description    String
  /// Stored in cents to avoid float rounding on money.
  price          Int
  compareAtPrice Int?
  imageUrl       String
  stock          Int         @default(0)
  featured       Boolean     @default(false)
  rating         Float       @default(0)
  reviewCount    Int         @default(0)
  categoryId     String
  category       Category    @relation(fields: [categoryId], references: [id])
  colors         Color[]
  sizes          Size[]
  images         ProductImage[]
  reviews        Review[]
  orderItems     OrderItem[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([categoryId])
  @@index([featured])
}

/// Extra product photography. The first image (position 0) is the card image.
model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String  @default("")
  position  Int     @default(0)

  @@index([productId])
}

model Review {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  author    String
  /// 1..5
  rating    Int
  title     String   @default("")
  body      String
  createdAt DateTime @default(now())

  @@index([productId])
}

model Coupon {
  id         String    @id @default(cuid())
  code       String    @unique
  percentOff Int
  active     Boolean   @default(true)
  usageLimit Int?
  usedCount  Int       @default(0)
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
}

model Order {
  id        String      @id @default(cuid())
  userId    String?
  user      User?       @relation(fields: [userId], references: [id])
  email     String
  fullName  String
  address   String
  city      String
  postcode  String
  country   String
  subtotal  Int
  /// Percentage coupon applied, if any
  discount  Int       @default(0)
  couponCode String?
  shipping  Int
  total     Int
  /// Reference returned by the payment provider (see src/lib/payments.ts).
  paymentReference String?
  /// "PENDING" | "PAID" | "SHIPPED" | "CANCELLED"
  status    String      @default("PENDING")
  items     OrderItem[]
  createdAt DateTime    @default(now())

  @@index([userId])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  /// Denormalised snapshot so historical orders survive product edits.
  name      String
  unitPrice Int
  quantity  Int
  size      String
  color     String

  @@index([orderId])
}
